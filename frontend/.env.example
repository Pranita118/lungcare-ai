# ---- LungCare AI frontend configuration ----
# Copy this file to `.env` (or `.env.local`) if the ML service is not on the
# local machine. With no configuration the frontend uses the Vite dev proxy,
# which forwards /api to http://127.0.0.1:8000.
#
# There is no demo/simulation setting. The application always uses the real
# trained artifacts, and shows a connection screen if the service is down.

# Base URL of the FastAPI ML service. Leave empty to use the Vite dev proxy.
VITE_API_BASE_URL=
