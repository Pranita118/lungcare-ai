# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- Trained model artifacts ----
# Regenerated by `python -m app.train` (see backend/render.yaml build command).
# They are deliberately NOT committed: random-forest.pkl alone is ~315 MB,
# which is over GitHub's 100 MB per-file limit, and the files are reproducible
# from the dataset that IS committed.
backend/artifacts/*.pkl
backend/artifacts/*.joblib
backend/artifacts/*.json

# ---- Node ----
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Compiled JavaScript must never sit next to the TypeScript sources. Vite
# resolves .js before .ts and .tsx, so a stale emitted file silently shadows the
# real source. These appear only if tsc is run with emission enabled.
#
# postcss.config.js IS tracked on purpose: PostCSS has no TypeScript config
# equivalent, so that one file is authored JavaScript.
frontend/src/**/*.js
frontend/vite.config.js
frontend/*.tsbuildinfo
tsconfig.*.tsbuildinfo

# ---- Secrets / local config ----
# .env.example IS committed (it documents the variables); real .env files are not.
.env
.env.*
!.env.example

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.log

# ---- Large media ----
# Recording.mp4 is a ~691 MB screen recording kept for the project submission.
# GitHub rejects any file over 100 MB, so it stays local. Keep it out of git and
# commit it separately (or upload it to your college portal / a drive link).
*.mp4
*.mov
*.zip
